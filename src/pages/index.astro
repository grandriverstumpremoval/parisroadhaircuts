---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Paris Road Haircuts | Haircuts in Paris, Ontario"
	description="Book a haircut at Paris Road Haircuts, a home-based salon at 569 Paris Road in Paris, Ontario. Non-charitable cuts are $20. Call (519) 442-5048 to arrange an appointment."
>
	<div class="site-shell">
		<header class="site-header">
			<a class="brand" href="#home" aria-label="Paris Road Haircuts home">
				<img class="brand-mark" src="/paris-road-logo.png" alt="" />
				<span class="brand-name">Paris Road<br />Haircuts</span>
			</a>
			<nav class="main-nav" aria-label="Main navigation">
				<a href="#services">Services</a>
				<a href="#about">Our story</a>
				<a href="#visit">Find us</a>
			</nav>
			<a class="header-cta" href="tel:+15194425048">Call to book <span aria-hidden="true">↗</span></a>
		</header>

		<main id="home">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span class="eyebrow-dot"></span> Home-based salon · Paris, Ontario</p>
					<h1 id="hero-title">A good haircut.<br /><em>A good cause.</em></h1>
					<p class="hero-description">
						Affordable, welcoming haircuts on Paris Road. Every non-charitable cut is <strong>$20</strong>.
						Call or message to check availability.
					</p>
					<div class="hero-actions">
						<a class="button button-dark" href="tel:+15194425048">
							Call (519) 442-5048
							<svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
								<path d="M7 17 17 7M7 7h10v10" stroke="currentColor" stroke-width="1.8" />
							</svg>
						</a>
						<a
							class="button button-light"
							href="https://www.google.com/maps/dir/?api=1&amp;destination=569%20Paris%20Rd%2C%20Paris%2C%20ON%20N3L%203E1"
							target="_blank"
							rel="noreferrer"
						>
							Get directions
						</a>
					</div>
					<a
						class="google-note"
						href="https://share.google/y4vY8fq8XHUksDzOL"
						target="_blank"
						rel="noreferrer"
					>
						<span class="google-star" aria-hidden="true">★</span>
						<span><strong>Local and loved</strong><small>See reviews on Google</small></span>
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
				</div>

				<div class="hero-visual">
					<div class="hero-image-frame">
						<img
							class="hero-image"
							src="/google-photo-5.webp"
							alt="A finished layered haircut at Paris Road Haircuts"
							fetchpriority="high"
							width="1360"
							height="1020"
						/>
					</div>
					<div class="price-stamp" aria-label="Non-charitable cuts, 20 dollars">
						<span>NON-CHARITABLE CUTS</span>
						<strong>$20</strong>
					</div>
					<div class="visual-caption">
						<span class="caption-icon" aria-hidden="true">✳</span>
						<span>Good cuts, right here in Paris.</span>
					</div>
				</div>
			</section>

			<section class="quick-facts" aria-label="Business details">
				<div class="fact">
					<span class="fact-icon" aria-hidden="true">01</span>
					<div><strong>Simple pricing</strong><span>$20 per non-charitable cut</span></div>
				</div>
				<div class="fact">
					<span class="fact-icon" aria-hidden="true">02</span>
					<div><strong>Paris, Ontario</strong><span>569 Paris Road</span></div>
				</div>
				<div class="fact">
					<span class="fact-icon" aria-hidden="true">03</span>
					<div><strong>Check availability</strong><span>Call or message ahead</span></div>
				</div>
			</section>

			<section class="services section" id="services" aria-labelledby="services-title">
				<div class="section-heading">
					<p class="eyebrow">Good hair, good heart</p>
					<h2 id="services-title">A fresh cut.<br /><em>A little extra care.</em></h2>
					<p>
						Come by for a haircut and stay for the friendly, personal service. For current availability,
						give us a call or send a message on Instagram.
					</p>
				</div>
				<div class="service-list">
					<article class="service-card">
						<div class="service-number">01 / THE CUT</div>
						<div class="service-title-row">
							<h3>Haircuts</h3>
							<span class="service-price">$20</span>
						</div>
						<p>All non-charitable cuts. One straightforward price.</p>
						<a href="tel:+15194425048">Call to ask about a cut <span aria-hidden="true">↗</span></a>
					</article>
					<article class="service-card service-card-accent">
						<div class="service-number">02 / GIVING BACK</div>
						<div class="service-title-row">
							<h3>Hair donation</h3>
							<span class="service-price service-price-text">Ask us</span>
						</div>
						<p>Read about the salon's hair-donation story, then get in touch about current options.</p>
						<figure class="donation-photo">
							<img
								src="/hair-donation.webp"
								alt="A client showing her long hair before donating it"
								loading="lazy"
								width="765"
								height="1020"
							/>
							<figcaption>A special hair-donation moment</figcaption>
						</figure>
						<a
							href="https://kitchener.ctvnews.ca/the-word-has-been-spreading-paris-hair-salon-offers-free-hair-styling-to-people-donating-hair-for-cancer-patients-1.6489566"
							target="_blank"
							rel="noreferrer"
						>
							Read the CTV story <span aria-hidden="true">↗</span>
						</a>
					</article>
				</div>
			</section>

			<section class="faq section" aria-labelledby="faq-title">
				<div class="faq-heading">
					<p class="eyebrow">Good to know</p>
					<h2 id="faq-title">A few quick answers.</h2>
				</div>
				<div class="faq-list">
					<details>
						<summary>Do I need an appointment?</summary>
						<p>
							Yes. Paris Road Haircuts is by appointment only. Call
							<a href="tel:+15194425048">(519) 442-5048</a> or message
							<a href="https://www.instagram.com/parisroadhaircuts/" target="_blank" rel="noreferrer">
								@parisroadhaircuts
							</a>
							to ask about availability.
						</p>
					</details>
					<details>
						<summary>How much does a haircut cost?</summary>
						<p>All non-charitable haircuts are $20. Contact the salon with questions about hair donation appointments.</p>
					</details>
					<details>
						<summary>Where is Paris Road Haircuts?</summary>
						<p>At 569 Paris Road, Paris, Ontario, N3L 3E1. Please arrange an appointment before visiting this home-based salon.</p>
					</details>
				</div>
			</section>

			<section class="gallery section" aria-labelledby="gallery-title">
				<div class="gallery-heading">
					<div>
						<p class="eyebrow">A little look at the craft</p>
						<h2 id="gallery-title">Made for a feel-good finish.</h2>
					</div>
					<a class="text-link" href="https://www.instagram.com/parisroadhaircuts/" target="_blank" rel="noreferrer">
						See Paris Road Haircuts on Instagram <span aria-hidden="true">↗</span>
					</a>
				</div>
				<div class="photo-grid">
					<figure class="photo photo-large">
						<img
							src="/google-photo-6.webp"
							alt="A short finished haircut at Paris Road Haircuts"
							loading="lazy"
							width="1360"
							height="1020"
						/>
						<figcaption>A fresh, finished cut</figcaption>
					</figure>
					<figure class="photo photo-small">
						<img
							src="/google-photo-9.webp"
							alt="A finished blonde hairstyle at the salon"
							loading="lazy"
							width="1360"
							height="1020"
						/>
						<figcaption>Soft, layered style</figcaption>
					</figure>
					<figure class="photo photo-small photo-second">
						<img
							src="/google-photo-10.webp"
							alt="A finished brunette hairstyle at the salon"
							loading="lazy"
							width="1360"
							height="1020"
						/>
						<figcaption>Another happy finish</figcaption>
					</figure>
				</div>
				<p class="photo-note">
					Photos from Paris Road Haircuts' Google Business Profile and owner-provided images.
				</p>
			</section>

			<section class="about section" id="about" aria-labelledby="about-title">
				<div class="about-mark" aria-hidden="true">PR</div>
				<div class="about-copy">
					<p class="eyebrow">More than a haircut</p>
					<h2 id="about-title">A local cut<br /><em>with heart.</em></h2>
					<p>
						Paris Road Haircuts is a home-based salon in Paris, Ontario, with a special place for community
	and hair donation. Every non-charitable cut is $20.
					</p>
					<a class="text-link" href="https://share.google/y4vY8fq8XHUksDzOL" target="_blank" rel="noreferrer">
						View the Google Business Profile <span aria-hidden="true">↗</span>
					</a>
				</div>
				<div class="about-image">
					<img
						src="/google-photo-3.webp"
						alt="Inside the Paris Road Haircuts salon"
						loading="lazy"
						width="1360"
						height="1020"
					/>
				</div>
			</section>

			<section class="visit section" id="visit" aria-labelledby="visit-title">
				<div class="visit-card">
					<div class="visit-copy">
						<p class="eyebrow">Come say hello</p>
						<h2 id="visit-title">Right on<br /><em>Paris Road.</em></h2>
						<p class="visit-address">569 Paris Road<br />Paris, ON N3L 3E1</p>
						<p class="visit-note">
							Home-based salon. Please call or message before visiting to confirm a time. Call or message
							for current hours and availability.
						</p>
						<div class="visit-actions">
							<a class="button button-dark" href="tel:+15194425048">Call (519) 442-5048</a>
							<a
								class="button button-outline"
								href="https://www.google.com/maps/dir/?api=1&amp;destination=569%20Paris%20Rd%2C%20Paris%2C%20ON%20N3L%203E1"
								target="_blank"
								rel="noreferrer"
							>
								Get directions
							</a>
						</div>
					</div>
					<div class="visit-links">
						<img
							class="visit-sign"
							src="/salon-sign.webp"
							alt="Paris Road Haircuts roadside sign with its phone number and by-appointment-only notice"
							loading="lazy"
							width="765"
							height="1020"
						/>
						<a href="https://share.google/y4vY8fq8XHUksDzOL" target="_blank" rel="noreferrer">
							<span class="visit-link-icon" aria-hidden="true">G</span>
							<span><strong>View on Google</strong><small>Reviews, details and directions</small></span>
							<span class="arrow" aria-hidden="true">↗</span>
						</a>
						<a href="https://www.instagram.com/parisroadhaircuts/" target="_blank" rel="noreferrer">
							<span class="visit-link-icon" aria-hidden="true">◎</span>
							<span><strong>Follow on Instagram</strong><small>@parisroadhaircuts</small></span>
							<span class="arrow" aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand footer-brand" href="#home" aria-label="Paris Road Haircuts home">
				<img class="brand-mark" src="/paris-road-logo.png" alt="" />
				<span class="brand-name">Paris Road<br />Haircuts</span>
			</a>
			<p>Good cuts. Good neighbours. Paris, Ontario.</p>
			<a class="footer-phone" href="tel:+15194425048">(519) 442-5048</a>
		</footer>
	</div>
</Layout>

<style>
	:global(html) {
		scroll-behavior: smooth;
		background: #f7f5ef;
	}

	:global(body) {
		margin: 0;
		color: #20231d;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 16px;
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
	}

	:global(*) {
		box-sizing: border-box;
	}

	:global(a) {
		color: inherit;
	}

	:global(a:focus-visible) {
		outline: 3px solid #db784e;
		outline-offset: 4px;
	}

	.site-shell {
		--ink: #20231d;
		--muted: #65675e;
		--paper: #f7f5ef;
		--cream: #efe9dd;
		--orange: #d9774c;
		--green: #304d3a;
		margin: 0 auto;
		max-width: 1440px;
		overflow: hidden;
		background: var(--paper);
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 92px;
		padding: 18px clamp(24px, 6vw, 88px);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		text-decoration: none;
	}

	.brand-mark {
		width: 48px;
		height: 48px;
		border-radius: 4px;
		background: white;
		object-fit: contain;
	}

	.brand-name {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 16px;
		font-weight: 700;
		line-height: 1.04;
	}

	.main-nav {
		display: flex;
		gap: clamp(20px, 3vw, 42px);
		margin-left: auto;
		margin-right: clamp(24px, 5vw, 70px);
	}

	.main-nav a,
	.header-cta,
	.text-link {
		font-size: 13px;
		font-weight: 700;
		text-decoration: none;
	}

	.main-nav a {
		color: #4f514a;
	}

	.main-nav a:hover,
	.text-link:hover {
		color: var(--orange);
	}

	.header-cta {
		display: inline-flex;
		align-items: center;
		gap: 13px;
		padding: 12px 17px;
		border: 1px solid #d5d2c8;
		border-radius: 999px;
		white-space: nowrap;
	}

	.header-cta span {
		color: var(--orange);
		font-size: 17px;
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
		align-items: center;
		gap: clamp(40px, 8vw, 110px);
		padding: 52px clamp(24px, 8vw, 116px) 90px;
	}

	.hero-copy {
		max-width: 510px;
		padding: 26px 0;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 9px;
		margin: 0 0 20px;
		color: #64705e;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.eyebrow-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--orange);
	}

	h1,
	h2,
	h3,
	p,
	figure {
		margin-top: 0;
	}

	h1,
	h2 {
		margin-bottom: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-weight: 400;
		letter-spacing: -0.055em;
		line-height: 0.99;
	}

	h1 {
		font-size: clamp(54px, 7.3vw, 98px);
	}

	h1 em,
	h2 em {
		color: var(--orange);
		font-weight: 400;
	}

	.hero-description {
		max-width: 430px;
		margin: 26px 0 28px;
		color: #585a53;
		font-size: 16px;
		line-height: 1.75;
	}

	.hero-description strong {
		color: var(--ink);
	}

	.hero-actions,
	.visit-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 11px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 12px;
		min-height: 49px;
		padding: 0 20px;
		border: 1px solid transparent;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 700;
		text-decoration: none;
		transition: transform 160ms ease, background 160ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button-dark {
		background: var(--green);
		color: white;
	}

	.button-dark:hover {
		background: #243f2e;
	}

	.button-dark svg {
		width: 15px;
		height: 15px;
	}

	.button-light {
		border-color: #dedbd2;
		background: transparent;
	}

	.google-note {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		margin-top: 34px;
		text-decoration: none;
	}

	.google-star {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		border-radius: 50%;
		background: #e9e3d6;
		color: #ad6d31;
		font-size: 16px;
	}

	.google-note strong,
	.google-note small,
	.visit-links strong,
	.visit-links small {
		display: block;
	}

	.google-note strong,
	.visit-links strong {
		font-size: 12px;
	}

	.google-note small,
	.visit-links small {
		color: var(--muted);
		font-size: 11px;
	}

	.arrow {
		margin-left: auto;
		color: var(--orange);
		font-size: 17px;
	}

	.hero-visual {
		position: relative;
		padding: 0 0 25px 20px;
	}

	.hero-image-frame {
		position: relative;
		height: clamp(370px, 42vw, 555px);
		overflow: hidden;
		border-radius: 48% 48% 7px 7px;
		background: #d9c9b3;
	}

	.hero-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 52% center;
	}

	.price-stamp {
		position: absolute;
		top: 40px;
		left: -18px;
		display: flex;
		width: 112px;
		height: 112px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.35);
		border-radius: 50%;
		background: var(--orange);
		color: white;
		transform: rotate(-9deg);
	}

	.price-stamp span {
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.11em;
	}

	.price-stamp strong {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 39px;
		font-weight: 400;
		line-height: 1.1;
	}

	.visual-caption {
		position: absolute;
		right: -10px;
		bottom: 0;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		border: 1px solid #e6e1d7;
		border-radius: 999px;
		background: var(--paper);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 13px;
		font-style: italic;
	}

	.caption-icon {
		color: var(--orange);
		font-size: 19px;
		font-style: normal;
	}

	.quick-facts {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		padding: 28px clamp(24px, 8vw, 116px);
		border-top: 1px solid #e6e1d7;
		border-bottom: 1px solid #e6e1d7;
		background: #fbfaf6;
	}

	.fact {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.fact-icon {
		color: var(--orange);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 14px;
	}

	.fact strong,
	.fact span:last-child {
		display: block;
	}

	.fact strong {
		font-size: 12px;
	}

	.fact div span {
		color: var(--muted);
		font-size: 11px;
	}

	.section {
		padding: 112px clamp(24px, 8vw, 116px);
	}

	.services {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: clamp(36px, 8vw, 110px);
		align-items: start;
	}

	.section-heading h2,
	.about-copy h2,
	.visit-copy h2 {
		font-size: clamp(43px, 5.2vw, 68px);
	}

	.section-heading > p:last-child {
		max-width: 390px;
		margin: 24px 0 0;
		color: var(--muted);
		font-size: 14px;
		line-height: 1.8;
	}

	.service-list {
		display: grid;
		gap: 13px;
	}

	.service-card {
		padding: 26px 28px 25px;
		border: 1px solid #e3ded3;
		border-radius: 5px;
		background: #fbfaf6;
	}

	.service-card-accent {
		background: #e9eee5;
		border-color: #e9eee5;
	}

	.service-number {
		color: #7c806f;
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.14em;
	}

	.service-title-row {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 14px;
		margin: 14px 0 7px;
	}

	.service-title-row h3 {
		margin-bottom: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 27px;
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.service-price {
		color: var(--green);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 29px;
	}

	.service-price-text {
		font-size: 17px;
		font-style: italic;
	}

	.service-card p {
		margin: 0 0 17px;
		color: var(--muted);
		font-size: 12px;
	}

	.donation-photo {
		position: relative;
		height: 180px;
		margin: 0 0 16px;
		overflow: hidden;
		background: #d9c9b3;
	}

	.donation-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 42%;
	}

	.donation-photo figcaption {
		position: absolute;
		right: 9px;
		bottom: 9px;
		padding: 6px 9px;
		background: rgba(247, 245, 239, 0.94);
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 11px;
